# GEMINI_API_KEY: Required for Gemini AI API calls (OCR & structured summaries).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Runtime Credentials (auto-injected by Google Cloud SQL integration)
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="carebridge"
SQL_USER="app_user"
SQL_PASSWORD="app_password"

# Cloud SQL Admin Credentials (used exclusively by Drizzle Kit migrations)
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# Optional: Google Cloud Storage bucket for private medical document storage.
# When omitted, documents are stored privately in PostgreSQL (no public URLs).
GCS_BUCKET_NAME=""

# Optional: Pluggable OCR Engine ('gemini' | 'easyocr' | 'external_python')
OCR_PROVIDER="gemini"
EXTERNAL_OCR_URL=""

# Optional: Comma-separated administrator email addresses
ADMIN_EMAILS=""

